[
  {
    "label": "Debug All Tests",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/target/debug/deps/rust_playground_test",
    "args": ["--test-threads", "1"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "build": {
      "command": "sh",
      "args": ["$ZED_WORKTREE_ROOT/.zed/build-test.sh", "$ZED_WORKTREE_ROOT"],
      "cwd": "$ZED_WORKTREE_ROOT",
    },
  },
  {
    "label": "Debug Current File Tests",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/target/debug/deps/rust_playground_test",
    "cwd": "$ZED_WORKTREE_ROOT",
    "processCreateCommands": [
      "script import os; root = os.environ.get('ZED_WORKTREE_ROOT', os.getcwd()); filter = open(os.path.join(root, 'target/debug/.test_filter')).read().strip(); lldb.debugger.HandleCommand('process launch -- ' + filter + ' --test-threads 1')",
    ],
    "build": {
      "command": "nu",
      "args": [
        "$ZED_WORKTREE_ROOT/.zed/build-test.nu",
        "$ZED_WORKTREE_ROOT",
        "$ZED_RELATIVE_DIR",
      ],
      "cwd": "$ZED_WORKTREE_ROOT",
    },
  },
]
