[
  {
    "label": "Debug Tests",
    "command": "cargo",
    "args": ["test", "--no-run"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Set Debug Filter (Current File)",
    "command": "nu",
    "args": ["$ZED_WORKTREE_ROOT/.zed/set-filter.nu", "$ZED_RELATIVE_DIR", "$ZED_WORKTREE_ROOT"],
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
