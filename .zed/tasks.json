[
  {
    "label": "Debug Tests",
    "command": "cargo",
    "args": ["test", "--no-run"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Set Debug Filter (Current File)",
    "command": "nu",
    "args": ["-c", "('$ZED_RELATIVE_DIR' | path basename) | save -f '$ZED_WORKTREE_ROOT/target/debug/.test_filter'"],
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
